{
  "name": "stockchoose-electron",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Local Electron stock strategy workstation inspired by guorn stock strategy page.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "rust:build": "node scripts/run-cargo.cjs build -p stockchoose-api --release",
    "rust:fmt": "node scripts/run-cargo.cjs fmt --check",
    "rust:test": "node scripts/run-cargo.cjs test --workspace",
    "rust:live-smoke": "node scripts/rust-live-smoke.mjs",
    "build": "tsc -b && vite build",
    "build:beta": "npm run test:unit && npm run rust:build && npm run build",
    "package:beta": "npm run build:beta && electron-builder --win portable --x64 --publish=never",
    "test:unit": "vitest run --dir src",
    "test": "npm run test:unit && npm run test:smoke",
    "test:smoke": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.stockchoose.beta",
    "productName": "StockChoose Beta",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release/beta"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "target/release/stockchoose-api.exe",
        "to": "stockchoose-api.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
