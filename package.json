{
  "name": "stockchoose-electron",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Local Electron stock strategy workstation inspired by guorn stock strategy page.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "agent:mcp": "node scripts/stockchoose-agent-mcp.mjs",
    "bun:api": "node scripts/start-bun-api.mjs",
    "bun:check": "bun build bun-api/server.ts --target=bun --outfile tmp/bun-api-check.mjs",
    "bun:compile": "bun build bun-api/server.ts --compile --windows-hide-console --outfile tmp/sidecars/stockchoose-bun-api.exe",
    "bun:live-smoke": "node scripts/bun-live-smoke.mjs",
    "build": "tsc -b && vite build",
    "build:beta": "npm run test:unit && npm run test:agent && npm run test:backend && npm run bun:check && npm run build",
    "package:beta": "npm run build:beta && npm run bun:compile && electron-builder --win portable --x64 --publish=never && node scripts/clean-beta-output.mjs",
    "test:unit": "vitest run --dir src",
    "test:agent": "vitest run bun-api/agent && node --test scripts/stockchoose-agent-client.test.mjs",
    "test:backend": "bun test bun-api/lib/outboundSecurity.test.ts && node --test electron/bun-api.test.cjs",
    "test": "npm run test:unit && npm run test:agent && npm run test:backend && npm run test:smoke",
    "test:smoke": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "8.18.1",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^26.8.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.stockchoose.beta",
    "productName": "StockChoose Beta",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "icon": "electron/icon.ico",
    "directories": {
      "output": "release/beta"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "bun-api/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tmp/sidecars/stockchoose-bun-api.exe",
        "to": "stockchoose-bun-api.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
